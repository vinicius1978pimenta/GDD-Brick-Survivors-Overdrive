# Servidor
PORT=3000
CORS_ORIGIN=*

# Banco de Dados (PostgreSQL / TypeORM)
# Para desenvolvimento local (host): DB_HOST=localhost e DB_PORT=5432 (ou 5433 se conectar ao Postgres do Docker)
# Para execucao dentro do container Docker: DB_HOST=postgres e DB_PORT=5432
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_aqui
DB_DATABASE=brick_survivors
DB_SYNCHRONIZE=false
DB_SSL=false

# Porta externa do Postgres no Docker Compose (5433 para evitar conflito caso a 5432 ja esteja em uso no host)
DB_EXTERNAL_PORT=5433

# Para provedores em nuvem (Neon, Supabase, Render, Railway), voce pode usar a URL direta:
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/brick_survivors
